---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found">
	<div class="not-found">
		<h1>Page not found</h1>
		<p>
			Sorry 😔, we couldn’t find what you were looking for.
			<br />
			<a href="/">Go home</a>.
		</p>
	</div>
</Layout>

<style>
	.not-found {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 32px;
		padding: 64px 16px;
		text-align: center;
		font-family: var(--font-italiana);
	}

	h1 {
		font-size: 300%;
		font-weight: normal;
		letter-spacing: 3px;
	}

	p {
		font-size: 150%;
		line-height: 1.6;
	}

	a {
		color: inherit;
	}
</style>
